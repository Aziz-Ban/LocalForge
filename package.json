{
  "name": "LocalForge",
  "displayName": "LocalForge",
  "description": "Start a local AI server and refine prompts using GitHub Copilot",
  "version": "0.0.2",
  "publisher": "Balitzy",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aziz-Ban/LocalForge.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "smart-copilot.openChat",
        "title": "Open LocalForge Chat"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "smart-copilot-sidebar",
          "title": "LocalForge",
          "icon": "$(flame)"
        }
      ]
    },
    "views": {
      "smart-copilot-sidebar": [
        {
          "type": "webview",
          "id": "smart-copilot.chatView",
          "name": "Chat"
        }
      ]
    },
    "keybindings": [
      {
        "command": "smart-copilot.openChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "20.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.8",
    "@vscode/test-electron": "^2.3.9",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "typescript": "^5.4.2"
  }
}
